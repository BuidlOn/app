# Base URL of the BuidlOn backend REST API. Required: the app talks to the live
# backend only, there is no mock or offline mode.
NEXT_PUBLIC_API_BASE_URL=https://buidlon-api.onrender.com

# URL to install the BuidlOn GitHub App on a repository.
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL="https://github.com/apps/<your-app-name>/installations/new"

# Shared secret used by src/middleware.ts to verify the JWT on /admin routes.
# MUST match the backend's signing secret. If unset, /admin is closed to
# everyone: the middleware fails closed rather than trusting a default.
JWT_SECRET=
