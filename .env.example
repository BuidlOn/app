# Base URL of the BuidlOn backend REST API.
# When unset, the frontend serves mock data from the local services layer.
NEXT_PUBLIC_API_BASE_URL=

# Toggle mock mode explicitly. "true" forces mocks even if an API URL is set.
NEXT_PUBLIC_USE_MOCKS=true

# Basic Auth for the /admin console (temporary, until real role-based auth).
# When BOTH are set, /admin requires this username + password. Leave unset for
# open access in local development.
ADMIN_USER=
ADMIN_PASSWORD=
